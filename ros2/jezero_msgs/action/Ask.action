# One schema-constrained Claude call: plan | interpret | anomaly | objective | report.
string kind
string ctx_json
---
bool ok
string error
string output_json
string prompt
string model
float32 latency_ms
float32 cost_usd
int32 tokens_out
int32 turns
string consults_json
---
string phase                   # starting | thinking | consulting jev | structuring | done | cancelled
int32 turns
int32 consults
float32 elapsed_s
string last_note               # the note on the latest jev consultation
